{
  "name": "KNSDC Participant Portal",
  "short_name": "KNSDC",
  "description": "Kalikapurna Binsangha Club Participant & Audition Portal",
  "start_url": "./KNSDC-Participant.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "./logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./KNSDC-Participant.html?shared=1",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".mp3", ".wav", ".m4a", ".aac", ".ogg"]
        }
      ]
    }
  }
}
